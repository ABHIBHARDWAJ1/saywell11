{
  "manifest_version": 3,
  "name": "SAYWELL",
  "version": "4.0.0",
  "description": "Notice charged patterns in what you write and get a clearer version, right where you type. Only runs when you ask it to.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_title": "SAYWELL", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "permissions": ["contextMenus", "scripting", "activeTab", "storage"],
  "host_permissions": ["http://localhost:8080/*", "https://*.onrender.com/*"],
  "background": { "service_worker": "background.js" },
  "commands": {
    "check-text": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Check the selected or focused text with SAYWELL" }
  }
}
